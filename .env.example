# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.

# A long, random, unpredictable string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# development | production | testing
FLASK_ENV=development

# Optional: override the default SQLite path, e.g. to point at Postgres
# in production: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///instance/enrollment.db
